{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "OpenAI": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/",
    "DefaultModel": "gpt-4.1-mini"
  },
  "AllowedHosts": "*"
}
